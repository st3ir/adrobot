# ---------------------------------------------------------------------------
# Adrobot configuration. Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local            # local | staging | production
DEBUG=false

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
# PostgreSQL: pip install '.[postgres]' then
# DATABASE_URL=postgresql+asyncpg://adrobot:password@localhost:5432/adrobot

# --- Keitaro ---------------------------------------------------------------
KEITARO_BASE_URL=https://tlgk.host
# Keitaro admin -> Profile -> API keys -> create a key
KEITARO_API_KEY=replace-me
KEITARO_TIMEOUT_SECONDS=20
KEITARO_MAX_RETRIES=2
KEITARO_CACHE_TTL_SECONDS=60

# Preferred campaign domain / group / traffic source by name.
# Leave empty to take the first one Keitaro returns.
KEITARO_DEFAULT_DOMAIN=
KEITARO_DEFAULT_GROUP=FORTESTS
KEITARO_DEFAULT_SOURCE=FORTESTS

# --- Campaign defaults -----------------------------------------------------
# Team convention: every test campaign is named test_<surname>_<something>.
CAMPAIGN_NAME_PREFIX=test_surname_
GEO_REDIRECT_URL=https://google.com

# --- Sessions / auth -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
# Must be true in production; set to false to use the UI over plain http://localhost
COOKIE_SECURE=false

# Optional: create this operator account on first start.
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# --- Hardening -------------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=65536
# Comma-separated, only needed when the UI is served from another origin.
CORS_ORIGINS=
